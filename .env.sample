# Google Cloud / Gemini Agent Platform & BigQuery Configuration
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI="TRUE"
MODEL_NAME="gemini-3.6-flash"

# Local A2A Agent Endpoints
GATEWAY_URL="http://localhost:8001"
CORPORATE_NAMES_AGENT_URL="http://localhost:8002"
ADK_A2A_SERVER_URL="http://localhost:8003"

# Shared HS256 JWT signing secret between gateway_agent (:8001) and corporate_names_analytics_agent (:8002).
# For local development, a default demo value is provided so both servers work out of the box.
# In production, inject this secret via Secret Manager (or use asymmetric RSA/ECDSA keys with a JWKS endpoint).
GATEWAY_JWT_SECRET="a2a-enterprise-gateway-hs256-signing-secret-2026"
